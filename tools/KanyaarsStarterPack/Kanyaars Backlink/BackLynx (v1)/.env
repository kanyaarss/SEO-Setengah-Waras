# Application Configuration
APP_ENV=production
LOG_LEVEL=info

# Redis Configuration
REDIS_URL=redis://redis:6379

# Go Orchestrator
GO_PORT=8080
GO_WORKER_COUNT=100

# Node.js Workers
NODE_PORT=3000
NODE_HEADLESS=true

# Database
DB_PATH=/app/data/backlynx.db

# Processing Configuration
MAX_CONCURRENT_URLS=1000
BATCH_SIZE=50
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30
